<%= render "manyfold_myminifactory/navigation" %>
<ol>
  <li>Sign in to <%= link_to "MyMiniFactory", "https://www.myminifactory.com/library", target: "_blank", rel: "noopener" %> in this browser.</li>
  <li>Open the <%= link_to "library API page", "https://www.myminifactory.com/api/data-library/objectPreviews", target: "_blank", rel: "noopener" %> in another tab.</li>
  <li>Copy the complete JSON response.</li>
  <li>Paste it into the box below and select <strong>Save</strong>.</li>
</ol>
<%= form_with url: manyfold_myminifactory.import_path, method: :post do |form| %>
  <%= form.text_area :json, value: @json, rows: 15, class: "form-control", aria: {label: "JSON"}, required: true %>
  <%= form.submit "Save", class: "btn btn-primary mt-2" %>
<% end %>
