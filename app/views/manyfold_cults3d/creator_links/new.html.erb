<%= render "manyfold_cults3d/navigation" %>
<h1><%= Icon icon: "link-45deg", role: "presentation" %> Link creator to Cults3D</h1>
<p><strong><%= @creator.name %></strong></p>
<p>Select a linked model to find this creator's Cults3D profile and sync their name, bio, and avatar.</p>
<% if @error %>
  <div class="alert alert-danger" role="alert"><%= @error %></div>
<% end %>
<% unless @configured %>
  <p>Set your Cults3D username and API key under Settings &gt; Integrations.</p>
<% end %>
<% if @model_links.empty? %>
  <p>No Cults3D-linked models are available for this creator.</p>
<% end %>
<%= form_with url: manyfold_cults3d.creator_link_path, method: :post, id: "cults3d-creator-link-form" do |form| %>
  <%= form.hidden_field :creator_id, value: @creator.to_param %>
  <% @model_links.each do |link| %>
    <div class="form-check mb-2">
      <%= form.radio_button :link_id, link.id, checked: link.id.to_s == @selected_link_id.to_s, class: "form-check-input", required: true %>
      <%= form.label :link_id, link.linkable.name, value: link.id, class: "form-check-label" %>
    </div>
  <% end %>
  <%= form.submit "Link and sync", class: "btn btn-primary", disabled: !@configured || @model_links.empty? %>
  <%= link_to "Cancel", main_app.creators_path, class: "btn btn-secondary" %>
<% end %>
