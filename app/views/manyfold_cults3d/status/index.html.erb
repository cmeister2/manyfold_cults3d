<%= render "manyfold_cults3d/navigation" %>
<p>This page lists your imported Cults3D library and shows which entries are linked to models in Manyfold.</p>
<% if @imported_at %>
  <div id="cults3d-import-summary">
    <p><%= @model_count %> models in database</p>
    <p>Imported at <%= @imported_at.strftime("%Y-%m-%d %H:%M:%S %Z") %></p>
  </div>
<% else %>
  <p><%= @linked ? "Cults3D is linked" : "Cults3D not linked" %></p>
<% end %>
<% if !@linked && policy(:settings).integrations? && @linked_models.values.any?(&:empty?) %>
  <div class="alert alert-info" role="status">Set your Cults3D username and API key in integration settings to create and sync models.</div>
<% end %>
<table id="cults3d-models" class="table">
  <thead>
    <tr><th scope="col">Name</th><th scope="col">Creator</th><th scope="col">Manyfold model</th></tr>
  </thead>
  <tbody>
    <% @library_models.each do |entry| %>
      <tr data-cults3d-id="<%= entry.cults3d_id %>">
        <td>
          <%= link_to entry.name, entry.url, target: "_blank", rel: "noopener" %>
          <% if (download_url = entry.library_entries.filter_map { |item| item["download_url"] }.first) %>
            <div class="small"><%= link_to "Download files on Cults3D", download_url, target: "_blank", rel: "noopener" %></div>
          <% end %>
        </td>
        <td><%= entry.creator_name %></td>
        <td>
          <% models = @linked_models.fetch(entry.cults3d_id) %>
          <% if models.any? %>
            <span>Linked</span>
            <% models.each do |model| %>
              <% if @visible_model_ids[model.id] %>
                <%= link_to model.name, main_app.model_path(model) %>
              <% end %>
            <% end %>
          <% else %>
            <span>Not linked</span>
            <% if @linked && policy(:settings).integrations? && policy(:model).create? %>
              <%= button_to "Create Model", manyfold_cults3d.create_model_path(id: entry.id),
                method: :post, class: "btn btn-outline-primary btn-sm" %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<p>Creating a model syncs its details and images. To add the 3D model files, download them from Cults3D and import them into Manyfold separately.</p>
