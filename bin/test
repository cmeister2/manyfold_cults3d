#!/usr/bin/env sh
set -eu

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

docker run --rm --pull=missing --network none --entrypoint /bin/ash \
  --mount "type=bind,source=$plugin_root,target=/plugins/manyfold_myminifactory,readonly" \
  --tmpfs /config \
  --env PLUGINS_PATH=/plugins \
  --env DATABASE_URL=sqlite3:/config/manyfold.sqlite3 \
  --env REDIS_URL=redis://127.0.0.1:6379/1 \
  --env MULTIUSER=enabled \
  --env MANYFOLD_LOG_LEVEL=warn \
  --env SECRET_KEY_BASE=manyfold-myminifactory-disposable-local-test-secret-with-no-real-data \
  --env MANYFOLD_MYMINIFACTORY_STATUS_TEST=1 \
  manyfold3d/manyfold-solo:0.146.0 -ec '
    cd /usr/src/app
    redis-server --bind 127.0.0.1 --save "" --appendonly no --daemonize yes --logfile /tmp/redis.log
    bundle exec rails db:prepare:with_data >/tmp/myminifactory-test-db.log 2>&1 || {
      cat /tmp/myminifactory-test-db.log
      exit 1
    }
    bundle exec rails runner /plugins/manyfold_myminifactory/test/status_test.rb
  '
