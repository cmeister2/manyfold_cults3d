<%= render "manyfold_myminifactory/navigation" %>
<p>This page lists your imported MyMiniFactory library and shows which entries are linked to models in Manyfold.</p>
<% if @imported_at %>
  <div id="myminifactory-import-summary">
    <p><%= @model_count %> models in database</p>
    <p>Imported at <%= @imported_at.strftime("%Y-%m-%d %H:%M:%S %Z") %></p>
  </div>
<% else %>
  <p><%= @linked ? "myminifactory is linked" : "myminifactory not linked" %></p>
<% end %>
<% if !@linked && policy(:settings).integrations? && @linked_models.values.any?(&:empty?) %>
  <div class="alert alert-info" role="status">Set your MyMiniFactory API key in integration settings to create and sync models.</div>
<% end %>
<table id="myminifactory-models" class="table">
  <thead>
    <tr><th scope="col">Name</th><th scope="col">ID</th><th scope="col">Manyfold model</th></tr>
  </thead>
  <tbody>
    <% @library_models.each do |entry| %>
      <tr data-myminifactory-id="<%= entry.myminifactory_id %>">
        <td><%= entry.name %></td>
        <td><%= entry.myminifactory_id %></td>
        <td>
          <% models = @linked_models.fetch(entry.myminifactory_id) %>
          <% if models.any? %>
            <span>Linked</span>
            <% models.each do |model| %>
              <% if @visible_model_ids[model.id] %>
                <%= link_to model.name, main_app.model_path(model) %>
              <% end %>
            <% end %>
          <% else %>
            <span>Not linked</span>
            <% if @linked && policy(:settings).integrations? && policy(:model).create? %>
              <%= button_to "Create Model", manyfold_myminifactory.create_model_path(id: entry.id),
                method: :post, class: "btn btn-outline-primary btn-sm" %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<p>Creating a model syncs its details and images. To add the 3D model files, download them from MyMiniFactory and import them into Manyfold separately.</p>
